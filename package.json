{
  "name": "10-smallest-agent-react-native-expo",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.23",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.15",
    "expo-dev-client": "~58.0.18",
    "expo-file-system": "~58.0.13",
    "expo-linking": "~58.0.16",
    "expo-router": "~58.0.30",
    "expo-sharing": "~58.0.22",
    "expo-status-bar": "~58.0.4",
    "prismjs": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "@types/node": "^26.6.6",
    "@types/prismjs": "^1.26.6",
    "vitest": "^5.1.0",
    "concurrently": "^10.0.7",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4"
  },
  "scripts": {
    "start": "expo start --port 5100",
    "dev": "concurrently --kill-others --names API,EXPO \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "expo start --web --localhost --port 5100",
    "generate:lesson": "node scripts/generate-lesson.mjs",
    "typecheck": "tsc --noEmit && npm --prefix backend run typecheck",
    "lint": "expo lint",
    "test": "vitest run --config vitest.config.mts && npm --prefix backend test",
    "build": "npm run generate:lesson && npm --prefix backend run build && expo export --platform web",
    "build:native": "expo export --platform android --platform ios --output-dir dist-native",
    "android": "expo start --android --port 5100",
    "ios": "expo start --ios --port 5100",
    "web": "npm run dev:web",
    "preview": "node scripts/preview.mjs"
  },
  "private": true
}
